{
  "name": "@aunboard/plugin-core",
  "version": "0.3.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Bundler-agnostic core for aunboard build-time stamping: JSX element discovery, stable id generation, the aunboard.ids.json map, and durable re-matching across refactors.",
  "keywords": [
    "aunboard",
    "jsx",
    "babel",
    "codegen",
    "product-tour",
    "data-attribute",
    "build-plugin"
  ],
  "author": "Nikhil Tirunagiri",
  "homepage": "https://github.com/NikhilTirunagiri/aunboard#readme",
  "bugs": "https://github.com/NikhilTirunagiri/aunboard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikhilTirunagiri/aunboard.git",
    "directory": "packages/plugin-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup",
    "pack:tgz": "tsup && npm pack"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "magic-string": "^0.30.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^25.9.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
